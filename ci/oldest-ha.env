# The oldest Home Assistant that Home Keeper supports. This is the only place that
# names it. The Docker integration tests run on it for every PR. hacs.json and the
# README badge must match it (tests/unit/test_oldest_ha.py checks that).
#
# To drop an old version: change these lines, hacs.json and the README badge, and
# add a CHANGELOG entry. OLDEST_HA is a Docker image tag.
OLDEST_HA=2024.6.4
OLDEST_HA_MIN=2024.6.0
