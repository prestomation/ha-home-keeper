# Home Assistant runtime artifacts, generated when the container runs locally
# (e.g. via ci/e2e-up.sh). Only the seeded fixtures below are tracked.
*.log
*.log.*
*.db
*.db-*
.HA_VERSION
.ha_run.lock
blueprints/
tts/
deps/
# Uploaded asset-document blobs the integration writes under the config dir at runtime
# — except the seeded ones for the water heater, whose metadata the .storage fixture
# below already declares. Those blobs have to exist on disk for a signed document URL
# to actually serve something (see tests/e2e/tests/documents.spec.ts).
home_keeper/*
!home_keeper/documents/
home_keeper/documents/*
!home_keeper/documents/e8d76383-4067-415c-975f-2ee73f475fa1/
# The seeded photos of "Replace fridge filter" (#399), with their thumbnails, for the
# same reason: the .storage fixture names them, so a signed URL has to serve them.
!home_keeper/task_photos/
home_keeper/task_photos/*
!home_keeper/task_photos/72347867-23a3-47f8-84d5-917be61e8a6d/
# And the old sticker of "Renew car registration", whose completion photo (the new
# sticker) is served from www/ as /local/, like a photo from the image store.
!home_keeper/task_photos/4fa204b6-ff6b-4bab-96c7-c8128b462c06/

# Ignore all generated .storage entries except the seeded fixtures.
.storage/*
!.storage/home_keeper
!.storage/core.config_entries
!.storage/core.label_registry
