# Home Assistant runtime artifacts, generated when the container runs locally
# (e.g. via ci/e2e-up.sh). Only the seeded fixtures below are tracked.
*.log
*.log.*
*.db
*.db-*
.HA_VERSION
.ha_run.lock
blueprints/
tts/
deps/
# Uploaded asset-document blobs the integration writes under the config dir at runtime
# — except the seeded ones for asset_water_heater, whose metadata the .storage fixture
# below already declares. Those blobs have to exist on disk for a signed document URL
# to actually serve something (see tests/e2e/tests/documents.spec.ts).
home_keeper/*
!home_keeper/documents/
home_keeper/documents/*
!home_keeper/documents/asset_water_heater/

# Ignore all generated .storage entries except the seeded fixtures.
.storage/*
!.storage/home_keeper
!.storage/core.config_entries
!.storage/core.label_registry
