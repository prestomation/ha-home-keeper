      "filter": {
        "status": "overdue",
        "groups": [
          {"labels": ["outdoor"], "labels_match": "any"},
          {"companions": ["battery_notes"]}
        ]
      },
      "expected": true
    },
    {
      "name": "two groups: the first takes it, so the second is never needed",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["indoor"], "managed_by": {"integration": "battery_notes", "display_name": "Battery Notes"}},
      "filter": {
        "status": "overdue",
        "groups": [
          {"companions": ["battery_notes"]},
          {"labels": ["outdoor"], "labels_match": "any"}
        ]
      },
      "expected": true
    },
    {
      "name": "two groups: each is half-matched, so neither takes it",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["indoor"], "area_id": "kitchen"},
      "filter": {
        "status": "all",
        "groups": [
          {"labels": ["outdoor"], "labels_match": "any", "areas": ["kitchen"]},
          {"labels": ["indoor"], "labels_match": "any", "areas": ["garage"]}
        ]
      },
      "expected": false
    },
    {
      "name": "an exclusion in one group does not reach the other",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["dog", "pro"], "area_id": "kitchen"},
      "filter": {
        "status": "all",
        "groups": [
          {"labels": ["dog"], "labels_match": "any", "exclude_labels": ["pro"]},
          {"areas": ["kitchen"]}
        ]
      },
      "expected": true
    },
    {
      "name": "an exclude-only group is active and drops the task it names",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["pro"]},
      "filter": {
        "status": "all",
        "groups": [
          {"exclude_labels": ["pro"]}
        ]
      },
      "expected": false
    },
    {
      "name": "an exclude-only group takes everything it does not name",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["dog"]},
      "filter": {
        "status": "all",
        "groups": [
          {"exclude_labels": ["pro"]}
        ]
      },
      "expected": true
    },
    {
      "name": "labels_match all: every listed label is present",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["dog", "outdoor"]},
      "filter": {
        "status": "all",
        "groups": [
          {"labels": ["dog", "outdoor"], "labels_match": "all"}
        ]
      },
      "expected": true
    },
    {
      "name": "labels_match all: one listed label is missing -> excluded",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["dog"]},
      "filter": {
        "status": "all",
        "groups": [
          {"labels": ["dog", "outdoor"], "labels_match": "all"}
        ]
      },
      "expected": false
    },
    {
      "name": "labels_match any: one listed label is enough",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["dog"]},
      "filter": {
        "status": "all",
        "groups": [
          {"labels": ["dog", "outdoor"], "labels_match": "any"}
        ]
      },
      "expected": true
    },
    {
      "name": "an unknown labels_match reads as any",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["dog"]},
      "filter": {
        "status": "all",
        "groups": [
          {"labels": ["dog", "outdoor"], "labels_match": "sometimes"}
        ]
      },
      "expected": true
    },
    {
      "name": "an empty group beside an active one is ignored, not a match-everything",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["cat"]},
      "filter": {
        "status": "all",
        "groups": [
          {"labels": ["dog"], "labels_match": "any"},
          {}
        ]
      },
      "expected": false
    },
    {
      "name": "groups that are all empty select every live task in the status tier",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["cat"], "area_id": "garage"},
      "filter": {
        "status": "all",
        "groups": [
          {},
          {}
        ]
      },
      "expected": true
    },
    {
      "name": "an empty groups list selects every live task in the status tier",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["cat"]},
      "filter": {
        "status": "all",
        "groups": []
      },
      "expected": true
    },
    {
      "name": "exclude_shopping inside a group drops the auto-buy reminder",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": [], "area_id": "kitchen", "source": {"buy": {"asset_id": "a1", "part_id": "p1"}}},
      "filter": {
        "status": "all",
        "groups": [
          {"areas": ["kitchen"], "exclude_shopping": true}
        ]
      },
      "expected": false
    },
    {
      "name": "exclude_shopping is per group: a sibling group still takes the buy reminder",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["dog"], "source": {"buy": {"asset_id": "a1", "part_id": "p1"}}},
      "filter": {
        "status": "all",
        "groups": [
          {"exclude_shopping": true},
          {"labels": ["dog"], "labels_match": "any"}
        ]
      },
      "expected": true
    },
    {
      "name": "the status gate beats a group that would have matched",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-30T12:00:00Z", "labels": ["dog"]},
      "filter": {
        "status": "overdue",
        "groups": [
          {"labels": ["dog"], "labels_match": "any"}
        ]
      },
      "expected": false
    },
    {
      "name": "a group entry that is not an object is dropped, and its sibling still decides",
      "task": {"id": "t", "enabled": true, "next_due": "2026-06-13T12:00:00Z", "labels": ["dog"]},
      "filter": {
        "status": "all",
        "groups": [
          "nonsense",
          {"labels": ["dog"], "labels_match": "any"}
        ]
      },
      "expected": true
    }
  ]
}
