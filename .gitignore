*.pyc
__pycache__/
.pytest_cache/
*.egg-info/
node_modules/

# Build artifacts
custom_components/home_keeper/frontend/dist/
home_keeper.zip

# Coverage artifacts
.coverage
htmlcov/

# Playwright
tests/e2e/.auth/
tests/e2e/playwright-report/
tests/e2e/test-results/

# The video walkthrough (ci/capture-video.sh) is a CI build artifact, never
# committed — it's captured per-PR and published to the gh-pages pr-preview-media
# umbrella (see walkthrough-preview.yml). Local runs still write here for debugging.
docs/videos/

# e2e: Docker creates this dir as the bind-mount target for the integration under
# test and the stub companion integrations (see tests/integration/docker-compose.yml).
tests/integration/ha_config/custom_components/

# Vale style packages fetched by `vale sync` per .vale.ini. This is a synced
# dependency, not source: errata-ai/vale-action fetches its own copy in CI.
styles/
build/

# Staged by ci/fetch-glues.sh for the upgrade suite (real glues at pinned SHAs +
# Home Keeper from the working tree + the upstream stubs). Never committed.
tests/upgrade/custom_components/
tests/upgrade/home_keeper_previous/
tests/upgrade/home_keeper_working_tree/

# Mutation testing scratch (mutmut copies the project into mutants/; Stryker
# sandboxes into .stryker-tmp/ and writes its report into reports/).
mutants/
.mutmut-cache
.stryker-tmp/
stryker.log
reports/
.venv/
