# Dependencies
/node_modules

# Production build
/build

# Generated Docusaurus cache
.docusaurus
.cache-loader

# Synced from ../docs/images at build/start time (see scripts/sync-assets.mjs)
/static/img/screenshots

# Generated from the integration at build/start time (see ci/generate_schema.py).
# Published at /schema/home-keeper-<format>.schema.json, which every exported file
# names on its first line.
/static/schema

# Generated from canonical Markdown at build/start time (see scripts/sync-docs.mjs)
/docs/guide
/docs/release-notes.md
/developer

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
